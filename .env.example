# Required for public/demo deployment; use long random values.
A01_ADMIN_KEY=replace-with-at-least-24-random-characters
A01_ENTERPRISE_KEY=replace-with-at-least-24-random-characters
A01_REQUIRE_ENV_SECRETS=1
A01_PUBLIC_MODE=1
# Demo only: idempotently load 100 internally tagged demonstration answer sheets.
A01_LOAD_DEMO_DATA=1
# Optional shared passwords for 3 teacher reviewers and 2 enterprise demo accounts.
A01_DEMO_TEACHER_PASSWORD=replace-with-at-least-12-characters
A01_DEMO_ENTERPRISE_PASSWORD=replace-with-at-least-12-characters
# Set to the exact public host, without the scheme, e.g. your-service.onrender.com
A01_ALLOWED_HOSTS=your-service.onrender.com
# Leave empty when frontend and API share the same origin.
A01_CORS_ORIGINS=

# Optional model integrations. Never commit real values.
TBOX_TOKEN=
TBOX_APP_ID=
ANT_LINE_API_KEY=
